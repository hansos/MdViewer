<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MdViewer.Rendering turns a parsed document into an Avalonia visual tree
    (SPECIFICATION.md 5.2).

    Renderers apply style CLASSES and never literal colours or sizes. The theme
    tokens and the styles that consume them live in MdViewer.App, so a theme
    change never requires touching a renderer, and this project needs no
    resource dictionary of its own.
  -->

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Markdig" Version="$(MarkdigVersion)" />
    <PackageReference Include="Mermaider" Version="$(MermaiderVersion)" />
    <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="$(SvgControlsSkiaAvaloniaVersion)" />

    <!--
      Syntax highlighting (SPECIFICATION.md 5.3). TextMateSharp is the engine;
      TextMateSharp.Grammars carries the bundled language grammars. Only the
      grammars are used: colours come from the theme tokens, never from a
      TextMate theme, so light/dark switching stays in one place.
    -->
    <PackageReference Include="TextMateSharp" Version="$(TextMateSharpVersion)" />
    <PackageReference Include="TextMateSharp.Grammars" Version="$(TextMateSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdViewer.Core\MdViewer.Core.csproj" />
  </ItemGroup>

</Project>
