<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MdViewer.App.ViewModels"
             mc:Ignorable="d"
             x:Class="MdViewer.App.Views.StartView"
             x:DataType="vm:MainWindowViewModel">

  <!--
    Start view (SPECIFICATION.md 5.14).

    The empty state when no tabs are open, and reachable at any time from Home
    in the tab strip. When a document is open it covers the document pane, so it
    needs an opaque background and a way back to what was being read. Its action
    buttons are therefore always available, not only on an empty session.
  -->

  <ScrollViewer VerticalScrollBarVisibility="Auto"
                Background="{DynamicResource ContentBackgroundBrush}">
    <StackPanel MaxWidth="620"
                HorizontalAlignment="Center"
                Margin="40,72,40,48">

      <!-- Only offer a way back when there is something to go back to -->
      <Button Classes="start-action"
              HorizontalAlignment="Left"
              Margin="0,0,0,20"
              Content="&#x2190;  Back to document   Esc"
              IsVisible="{Binding CanLeaveStartPage}"
              Command="{Binding HideStartPageCommand}" />

      <TextBlock Classes="start-title" Text="KT MD Viewer" />
      <TextBlock Classes="md-caption"
                 Margin="0,4,0,40"
                 IsVisible="{Binding !CanLeaveStartPage}"
                 Text="No document open." />

      <Border Height="44" IsVisible="{Binding CanLeaveStartPage}" />

      <TextBlock Classes="sidebar-header" Text="RECENT" Margin="2,0,0,10"
                 IsVisible="{Binding HasRecentDocuments}" />

      <ItemsControl ItemsSource="{Binding VisibleRecentDocuments}"
                    IsVisible="{Binding HasRecentDocuments}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RecentDocumentViewModel">

            <Button Classes="recent-card"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{Binding Exists}"
                    ToolTip.Tip="{Binding FullPath}"
                    Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).OpenRecentCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="3">
                  <TextBlock Classes="recent-title" Text="{Binding Title}" />
                  <TextBlock Classes="recent-path" Text="{Binding Directory}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Classes="recent-age"
                           VerticalAlignment="Center"
                           Text="{Binding StatusText}" />
              </Grid>
            </Button>

          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Button Classes="start-action"
              HorizontalAlignment="Left"
              Margin="0,10,0,0"
              IsVisible="{Binding HasMoreRecentDocuments}"
              Content="{Binding RecentToggleText}"
              Command="{Binding ToggleRecentExpandedCommand}" />

      <TextBlock Classes="md-caption"
                 Margin="2,10,0,0"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasRecentDocuments}"
                 Text="An entry whose file has been moved or deleted is shown as unavailable rather than quietly dropped. Existence is checked here, at display time — startup never waits on the file system." />

      <!-- First run, or a session with nothing opened yet -->
      <StackPanel Spacing="6" IsVisible="{Binding !HasRecentDocuments}">
        <TextBlock Classes="md-body"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Nothing opened yet. Open a file, or open a folder to browse a workspace in the sidebar." />
        <TextBlock Classes="md-caption"
                   TextWrapping="Wrap"
                   Text="The most recent documents will appear here, newest first. They are remembered for this session; persisting them across launches lands with session restore in M6." />
      </StackPanel>

      <!-- Actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,36,0,0">
        <Button Classes="start-action"
                Content="Open file…   Ctrl+O"
                Command="{Binding OpenFilesCommand}" />
        <Button Classes="start-action"
                Content="Open folder…"
                Command="{Binding OpenFolderCommand}" />
        <Button Classes="start-action"
                Content="Quick open   Ctrl+P"
                Command="{Binding ShowQuickOpenCommand}" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
